@page "/"

@using MudBlazor
@inherits LayoutComponentBase
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Style="height:calc(100vh - 64px); display:flex; flex-direction:column">
    <MudText Typo="Typo.h5" Class="font-semibold mb-4">Hi, I’m Georgios Dimopoulos, 32 years old developer, from Greece</MudText>
    <MudGrid GutterSize="1" Justify="Justify.FlexStart"
             AlignItems="AlignItems.Stretch"
             Style="flex:1;">
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudButton Style="width:100%; height:100%; background-color:lightgoldenrodyellow; color:black;">
                WORK
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudButton Style="width:100%; height:100%; background-color:lightgreen; color:black;">
                STUDIES
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudButton Style="width:100%; height:100%; background-color:lightblue; color:black;">
                LIFE
            </MudButton>
        </MudItem>
    </MudGrid>
</MudContainer>
