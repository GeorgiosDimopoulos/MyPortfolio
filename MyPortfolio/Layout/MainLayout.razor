@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-root">
    <MudAppBar Style="position:static" Color="Color.Dark" Elevation="1">
        <MudText Typo="Typo.h6">My personal Portfolio</MudText>
    </MudAppBar>

    <main class="app-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-6 d-flex flex-column" Style="width:100%; flex:1;">
            @Body
        </MudContainer>
    </main>
</div>
